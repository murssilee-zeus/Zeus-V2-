<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	package="com.zeus.v2"
	android:versionCode="21"
	android:versionName="2.1-fixed">

	<uses-sdk
		android:minSdkVersion="1"
		android:targetSdkVersion="1"/>

	<uses-permission
		android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

	<uses-permission
		android:name="android.permission.RECORD_AUDIO"/>

	<uses-permission
		android:name="android.permission.FOREGROUND_SERVICE"/>

	<uses-permission
		android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

	<uses-permission
		android:name="android.permission.POST_NOTIFICATIONS"/>

	<uses-permission
		android:name="android.permission.WAKE_LOCK"/>

	<application
		android:name=".ZeusApp"
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/Theme.ZeusV2"
		android:requestLegacyExternalStorage="true"
		tools:targetApi="34">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:screenOrientation="landscape"
			android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
			android:theme="@style/Theme.ZeusV2">

			<intent-filter>

				<action
					android:name="android.intent.action.MAIN"/>

				<category
					android:name="android.intent.category.LAUNCHER"/>

			</intent-filter>

		</activity>

		<service
			android:name=".AudioEngineService"
			android:enabled="true"
			android:exported="false"
			android:foregroundServiceType="mediaPlayback"/>

		<service
			android:name=".ZeusTileService"
			android:exported="true"
			android:icon="@drawable/ic_eq_tile"
			android:label="@string/eq_tile_label"
			android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">

			<intent-filter>

				<action
					android:name="android.service.quicksettings.action.QS_TILE"/>

			</intent-filter>

		</service>

	</application>

</manifest>
